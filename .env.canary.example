# Canary mode environment template for VPS deployment.

# QuickNode or other dedicated RPC for Base.
BASE_RPC_PRIMARY=
BASE_RPC_FALLBACK=
BASE_WS=
QUICKNODE_API_KEY=

# Solana RPC is optional unless you enable Solana execution later.
SOL_RPC_PRIMARY=

POSTGRES_DSN=
REDIS_URL=redis://127.0.0.1:6379/0
DASHBOARD_TOKEN=

# Wallet address used only for readiness checks and allowlist display.
CANARY_WALLET_ADDRESS=
WALLET_PASSPHRASE=

# Optional OKX Onchain credentials. Fill these only if
# configs/config.canary.toml sets execution.backend = "okx-onchain".
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Optional for future WaaS-style integration; not required for DEX auth test.
OKX_PROJECT_ID=
NPM_BASE_ADDRESS=
