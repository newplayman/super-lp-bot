# Canary mode environment template for VPS deployment.
#
# IMPORTANT: This template exists for documentation and future use ONLY.
# The canary mode is currently LOCKED (see
# reports/lp_long_horizon_r1_pause_and_freeze/20260607_191500/FINAL_PAUSE_VERDICT.json
# and reports/p0_postgres_shadow_audit/2026-06-09/FINAL_AUDIT_VERDICT.json).
# To actually run canary/live, the binary requires LPBOT_CONFIRM_LIVE=YES
# (see cmd/lpbot/mode_live.go:21-22). Per the current lockdown, this template
# MUST be copied to .env.canary with LPBOT_CONFIRM_LIVE=NO (or unset), and
# the canary service MUST remain disabled. Do not start the canary service
# without first reopening the LP strategy research freeze.

# Lock: canary/live must remain disabled. Setting this to YES requires an
# explicit freeze reopen in a separate conversation turn.
LPBOT_CONFIRM_LIVE=NO

# QuickNode or other dedicated RPC for Base.
BASE_RPC_PRIMARY=
BASE_RPC_FALLBACK=
BASE_WS=
QUICKNODE_API_KEY=

# Solana RPC is optional unless you enable Solana execution later.
SOL_RPC_PRIMARY=

POSTGRES_DSN=
REDIS_URL=redis://127.0.0.1:6379/0
DASHBOARD_TOKEN=

# Wallet address used only for readiness checks and allowlist display.
CANARY_WALLET_ADDRESS=
WALLET_PASSPHRASE=

# Optional OKX Onchain credentials. Fill these only if
# configs/config.canary.toml sets execution.backend = "okx-onchain".
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Optional for future WaaS-style integration; not required for DEX auth test.
OKX_PROJECT_ID=
NPM_BASE_ADDRESS=

# Telegram alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
