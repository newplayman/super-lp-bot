[Unit]
Description=LP Bot Canary Mode
After=network.target

[Service]
Type=simple
User=lpbot
WorkingDirectory=/opt/lpbot/lp-bot-v3
EnvironmentFile=/opt/lpbot/lp-bot-v3/.env.canary
EnvironmentFile=/opt/lpbot/lp-bot-v3/.env.postgres
EnvironmentFile=/opt/lpbot/lp-bot-v3/.env.redis
EnvironmentFile=/opt/lpbot/lp-bot-v3/.env.dashboard
ExecStart=/opt/lpbot/lp-bot-v3/bin/lpbot-live --config=/opt/lpbot/lp-bot-v3/configs/config.canary.toml
Restart=always
RestartSec=5
RestartPreventExitStatus=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
