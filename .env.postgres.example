# VPS shadow deployment environment variables.

# RPC endpoints
BASE_RPC_PRIMARY=
BASE_RPC_FALLBACK=
BASE_WS=
SOL_RPC_PRIMARY=

# PostgreSQL DSN for configs/config.shadow.toml or configs/config.vps.toml
# e.g. postgresql://lpbot:password@127.0.0.1:54322/lpbot_shadow?sslmode=disable
DATABASE_URL=

# Redis url for runtime heartbeat / future cache-queue integration
REDIS_URL=redis://127.0.0.1:6379/0
