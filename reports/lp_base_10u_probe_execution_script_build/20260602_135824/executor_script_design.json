        "describe approve(mint, decrease, collect, revoke calls",
        "include candidate freeze + tick range + amount + deadline placeholder"
      ],
      "forbidden": [
        "signing", "sending", "encoding r/s/v"
      ],
      "writes_to": "reports/lp_base_10u_probe_execution_runtime/<run_id>/unsigned_package.json (local only)",
      "exit_code": 0,
      "asserts": {
        "unsigned_only": true,
        "no_signature": true,
        "no_send": true,
        "execution_not_authorized": true
      }
    },
    "validate-approval": {
      "purpose": "parse + validate future execution approval phrase",
      "allowed": [
        "regex match against canonical phrase template",
        "extract wallet / pool / notional / hold fields"
      ],
      "forbidden": [
        "store approval as authorization",
        "auto-execute on valid phrase"
      ],
      "writes_to": "reports/lp_base_10u_probe_execution_runtime/<run_id>/approval_validation.json (local only)",
      "exit_code": 0,
      "asserts": {
        "executes_now": false,
        "authorization_granted": false,
        "next_step_even_if_valid": "user_must_reapprove_at_execution_time_after_review_stage"
      }
    },
    "execute-disabled": {
      "purpose": "stub that always aborts",
      "always_raises": "ExecutionDisabledInBuildStage(EXECUTION_DISABLED_IN_BUILD_STAGE)",
      "exit_code": 1
    }
  },

  "modes_rejected": {
    "execute": {
      "behavior": "REJECTED with exit_code=3",
