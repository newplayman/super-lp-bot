    {"action": "QuoterV2.quoteExactInputSingle WETH->USDC", "expect": "out ~ 9.95-10.0 USDC"},
    {"action": "QuoterV2.quoteExactInputSingle USDC->WETH", "expect": "out ~ 0.005 WETH"},
    {"action": "eth_estimateGas(mint_call)", "expect": "in 180k +/- 2x range"},
    {"action": "stop_condition evaluation", "expect": "all PASS or all documented WARNs"}
  ],

  "preflight_forbidden": [
    "no signing",
    "no sending",
    "no approve",
    "no mint",
    "no collect",
    "no decrease",
    "no increase",
    "no swap",
    "no bridge"
