  "db_schema_proposals": {
    "_status": "research_only_no_production_tables_created_this_round",
    "_naming_convention": "lp_probe_*_v1 - separate from production lpbot tables",
    "tables": [
      {
        "name": "lp_probe_preflight_review_v1",
        "purpose": "Stores each preflight review packet produced by Phase G",
        "columns": [
          "review_id UUID PRIMARY KEY",
          "run_id TEXT NOT NULL",
          "stage TEXT NOT NULL",
          "candidate_pool TEXT NOT NULL",
          "candidate_pair TEXT NOT NULL",
          "candidate_fee_tier INT NOT NULL",
          "candidate_notional_usd NUMERIC NOT NULL",
          "candidate_hold_window TEXT NOT NULL",
          "review_packet JSONB NOT NULL",
          "dry_run_builder_allowed_next BOOL NOT NULL",
          "human_approval_required BOOL NOT NULL DEFAULT true",
          "human_approval_received BOOL NOT NULL DEFAULT false",
          "human_approval_at TIMESTAMPTZ NULL",
          "created_at TIMESTAMPTZ NOT NULL DEFAULT now()"
        ]
      },
      {
        "name": "lp_probe_execution_ledger_v1",
        "purpose": "One row per executed probe (only when probe is approved + executed in a future stage)",
        "columns": [
          "probe_id UUID PRIMARY KEY",
          "review_id UUID NOT NULL REFERENCES lp_probe_preflight_review_v1(review_id)",
          "wallet_address TEXT NOT NULL",
          "pool_address TEXT NOT NULL",
          "token0 TEXT NOT NULL",
          "token1 TEXT NOT NULL",
          "fee_tier INT NOT NULL",
          "tick_lower INT NOT NULL",
          "tick_upper INT NOT NULL",
          "notional_usd_planned NUMERIC NOT NULL",
          "notional_usd_actual NUMERIC NULL",
          "mint_tx_hash TEXT NULL",
          "token_id NUMERIC NULL",
          "approval_tx_hash TEXT NULL",
          "approval_amount NUMERIC NULL",
          "entry_block_number BIGINT NULL",
          "exit_block_number BIGINT NULL",
          "decrease_tx_hash TEXT NULL",
          "collect_tx_hash TEXT NULL",
          "swap_back_tx_hash TEXT NULL",
          "revoke_tx_hash TEXT NULL",
          "exit_decision_reason TEXT NULL",
          "realized_pnl_usd NUMERIC NULL",
          "actual_fee_accrual_usd NUMERIC NULL",
          "gas_spent_total_usd NUMERIC NULL",
          "net_pnl_usd NUMERIC NULL",
          "hold_duration_seconds INT NULL",
          "created_at TIMESTAMPTZ NOT NULL DEFAULT now(),",
          "completed_at TIMESTAMPTZ NULL"
        ]
      },
      {
        "name": "lp_probe_position_fee_trace_v1",
        "purpose": "Periodic samples during hold; one row per (probe_id, sample_at)",
        "columns": [
          "probe_id UUID NOT NULL REFERENCES lp_probe_execution_ledger_v1(probe_id)",
          "sample_at TIMESTAMPTZ NOT NULL",
          "block_number BIGINT NOT NULL",
          "current_tick INT NOT NULL",
          "current_sqrt_price_x96 NUMERIC NOT NULL",
          "position_liquidity NUMERIC NOT NULL",
          "fee_growth_inside0_x128 NUMERIC NOT NULL",
          "fee_growth_inside1_x128 NUMERIC NOT NULL",
          "tokens_owed0 NUMERIC NOT NULL",
          "tokens_owed1 NUMERIC NOT NULL",
          "in_range BOOL NOT NULL",
          "mark_to_market_usd NUMERIC NULL",
          "PRIMARY KEY (probe_id, sample_at)"
        ]
      },
      {
        "name": "lp_probe_exit_trace_v1",
        "purpose": "Single row per probe with the exit-time snapshot",
        "columns": [
          "probe_id UUID PRIMARY KEY REFERENCES lp_probe_execution_ledger_v1(probe_id)",
          "exit_at TIMESTAMPTZ NOT NULL",
          "exit_block_number BIGINT NOT NULL",
          "exit_decision_reason TEXT NOT NULL",
          "decrease_tx_hash TEXT NULL",
          "collect_tx_hash TEXT NULL",
          "final_tokens_owed0 NUMERIC NULL",
          "final_tokens_owed1 NUMERIC NULL",
          "collected_token0 NUMERIC NULL",
          "collected_token1 NUMERIC NULL",
          "swap_back_required BOOL NOT NULL DEFAULT false",
          "swap_back_quote_token_in TEXT NULL",
          "swap_back_quote_token_out TEXT NULL",
          "swap_back_quote_amount_in NUMERIC NULL",
          "swap_back_quote_amount_out NUMERIC NULL",
          "swap_back_quote_drift_vs_mint_bps INT NULL",
          "swap_back_tx_hash TEXT NULL",
          "post_exit_token0_balance NUMERIC NULL",
          "post_exit_token1_balance NUMERIC NULL",
          "gas_spent_total_units BIGINT NULL",
          "gas_spent_total_usd NUMERIC NULL",
          "revoke_tx_hash TEXT NULL",
          "revoke_confirmed BOOL NULL"
        ]
      }
    ]
  },
