      "hold_duration_seconds": "uint64",
      "hold_duration_minutes": "decimal string",
      "success_status": "string ('success' | 'halt_<id>' | 'exit_immediate_<id>')",
      "halt_or_exit_reason_id": "string (FK to Phase E stop_conditions.id, if applicable)"
    }
  },

  "summary_persistence": {
    "in_run_dir": [
      "entry.json",
      "hold_<minute>.json (one per minute)",
      "fee_trace_<sample>.json",
      "exit.json",
      "post_exit.json",
