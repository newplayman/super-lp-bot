version: "2"
run:
  build-tags:
    - dryrun
    - shadow
    - live
    - property
    - fork
    - chaos
linters:
  enable:
    - bodyclose
    - gocritic
    - gosec
    - misspell
    - revive
  disable:
    - lll
  settings:
    gosec:
      excludes:
        - G404
  exclusions:
    generated: lax
    presets:
      - comments
      - common-false-positives
      - legacy
      - std-error-handling
    rules:
      - linters:
          - errcheck
          - gosec
        path: _test\.go
      - linters:
          - gocritic
        path: cmd/.*/main\.go
    paths:
      - third_party$
      - builtin$
      - examples$
formatters:
  exclusions:
    generated: lax
    paths:
      - third_party$
      - builtin$
      - examples$
