# Common env template for lp-bot development and deployment.
# Copy to .env and fill values locally.

# Base RPC endpoints
# Use your QuickNode HTTPS URL here for canary/live.
BASE_RPC_PRIMARY=
BASE_RPC_FALLBACK=
# Use your QuickNode WSS URL here if available.
BASE_WS=
SOL_RPC_PRIMARY=
QUICKNODE_API_KEY=
BASESCAN_API_KEY=
ETHERSCAN_API_KEY=
# Optional Solana fee payer address for read-only simulation readiness.
# This is a public address only, not a private key.
SOLANA_FEE_PAYER_ADDRESS=

# Optional database variable used by local sqlite mode
SQLITE_PATH=./data/shadow.db

# Optional redis endpoint for runtime heartbeat / cache integration
REDIS_URL=redis://127.0.0.1:6379/0

# Generic placeholder, keep empty in production unless actually needed
DATABASE_URL=
POSTGRES_DSN=

# Dashboard auth
DASHBOARD_TOKEN=

# Telegram alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Live / canary wallet allowlists
CANARY_WALLET_ADDRESS=
LIVE_WALLET_ADDRESS=
WALLET_PASSPHRASE=

# Optional OKX Onchain API credentials.
# Leave empty when execution.backend=native-rpc.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Optional for future WaaS-style integration; not required for DEX auth test.
OKX_PROJECT_ID=
NPM_BASE_ADDRESS=
