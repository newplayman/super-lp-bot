# Common env template for lp-bot development and deployment.
# Copy to .env and fill values locally.

# Base RPC endpoints
BASE_RPC_PRIMARY=
BASE_RPC_FALLBACK=
BASE_WS=
SOL_RPC_PRIMARY=

# Optional database variable used by local sqlite mode
SQLITE_PATH=./data/shadow.db

# Optional redis endpoint (reserved for later integration)
REDIS_URL=

# Generic placeholder, keep empty in production unless actually needed
DATABASE_URL=
POSTGRES_DSN=
